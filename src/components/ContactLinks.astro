---
import { links } from '../content/site';

interface Props {
	label: string;
	compact?: boolean;
}

const { label, compact = false } = Astro.props;

const icons = {
	mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
	calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
	linkedin:
		'<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 10v7M8 7v.01M12 17v-7M12 13a3 3 0 0 1 6 0v4"/>',
	github:
		'<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>',
	file: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/>',
};

const all = [
	{ text: 'Email me', href: links.email, icon: icons.mail, primary: true },
	{ text: 'Book a chat', href: links.booking, icon: icons.calendar },
	{ text: 'LinkedIn', href: links.linkedin, icon: icons.linkedin },
	{ text: 'GitHub', href: links.github, icon: icons.github },
	...(links.resume ? [{ text: 'Resume (PDF)', href: links.resume, icon: icons.file }] : []),
];
const items = compact ? all.slice(0, 2) : all;
---

<nav class:list={[compact ? 'contact-bar-links' : 'cta']} aria-label={label}>
	{
		items.map((item) => (
			<a class:list={['button', { 'button-primary': item.primary }]} href={item.href}>
				<svg
					class="button-icon"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					set:html={item.icon}
				/>
				{item.text}
			</a>
		))
	}
</nav>
