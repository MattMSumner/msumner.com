---
import '@fontsource-variable/schibsted-grotesk';
import { Picture } from 'astro:assets';
import headshot from '../assets/headshot.jpg';
import summitStage from '../assets/summit-stage.jpg';
import ContactLinks from './ContactLinks.astro';
import SocialMeta from './SocialMeta.astro';
import {
	alsoExperience,
	experience,
	impact,
	links,
	person,
	principles,
	talks,
	talksNote,
	testimonials,
	writing,
} from '../content/site';
import '../styles/base.css';
import '../styles/theme.css';

interface Props {
	/** Theme mockup to preview; only set by the pages under /mockups/. */
	variant?: string;
}

const { variant } = Astro.props;
const description = `${person.title}. ${person.tagline} Led the org of up to 50 engineers behind HubSpot’s Customer Agent.`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const featured = testimonials.find((testimonial) => testimonial.featured);
const carouselTestimonials = testimonials.filter((testimonial) => testimonial !== featured);
---

<html lang="en" data-variant={variant}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{person.name} · {person.title}</title>
		<meta name="description" content={description} />
		{variant && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonical} />
		<SocialMeta title={`${person.name} · ${person.title}`} description={description} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="hero">
			<div class="hero-photo">
				<Picture
					src={headshot}
					widths={[320, 480, 725]}
					sizes="(min-width: 960px) 256px, 160px"
					formats={['avif', 'webp']}
					alt="Portrait of Matt Sumner, smiling"
					loading="eager"
				/>
			</div>
			<div class="hero-text">
				<p class="eyebrow">{person.title}</p>
				<h1>{person.name}</h1>
				<p class="tagline">{person.tagline}</p>
				{
					person.intro.map((paragraph) => (
						<p class="intro">
							{paragraph.lead}
							{paragraph.link && <a href={paragraph.link.href}>{paragraph.link.text}</a>}
							{paragraph.rest}
						</p>
					))
				}
				<p class="where">
					<span>{person.location}</span>
					<span>{person.workPreferences}</span>
				</p>
				<ContactLinks label="Get in touch" />
			</div>
		</header>

		<main id="main">
			<section id="impact" aria-labelledby="impact-heading">
				<h2 id="impact-heading">Impact</h2>
				<ul class="stats">
					{
						impact.map((stat) => (
							<li class="stat">
								<span class="stat-figure">{stat.figure}</span>
								<span class="stat-label">{stat.label}</span>
								<span class="stat-detail">{stat.detail}</span>
							</li>
						))
					}
				</ul>
			</section>

			<section id="leadership" aria-labelledby="leadership-heading">
				<h2 id="leadership-heading">How I lead</h2>
				<div class="principles">
					{
						principles.map((principle, index) => (
							<article class="principle">
								<span class="principle-number" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{principle.title}</h3>
								<p>{principle.body}</p>
							</article>
						))
					}
				</div>
			</section>

			<section id="experience" aria-labelledby="experience-heading">
				<h2 id="experience-heading">Experience</h2>
				<ol class="timeline">
					{
						experience.map((job) => (
							<li class="company">
								<div class="company-head">
									<h3>{job.company}</h3>
									<p class="meta">
										{job.place} · {job.dates}
									</p>
								</div>
								<ol class="roles">
									{job.roles.map((role) => (
										<li class="role">
											<h4>{role.title}</h4>
											<p class="meta">{role.dates}</p>
											<p>{role.summary}</p>
										</li>
									))}
								</ol>
							</li>
						))
					}
				</ol>
				<ul class="also">
					{
						alsoExperience.map((item) => (
							<li>
								<strong>{item.title}</strong> <span>{item.detail}</span>{' '}
								<span class="meta">{item.dates}</span>
							</li>
						))
					}
				</ul>
			</section>

			<section id="speaking" aria-labelledby="speaking-heading">
				<h2 id="speaking-heading">Speaking</h2>
				<figure class="stage">
					<Picture
						src={summitStage}
						widths={[384, 768]}
						sizes="(min-width: 960px) 320px, 100vw"
						formats={['avif', 'webp']}
						alt="Matt Sumner on stage in front of a large audience, presenting a slide about Customer Agent"
					/>
					<figcaption>Speaking about Customer Agent at Inbound Marketing Summit 2026 in Medellín.</figcaption>
				</figure>
				<ul class="talks">
					{
						talks.map((talk) => (
							<li class="talk">
								<span class="talk-title">{talk.title}</span>
								<span class="meta">
									{talk.href ? <a href={talk.href}>{talk.venue}</a> : talk.venue}
									{talk.year && ` · ${talk.year}`}
								</span>
							</li>
						))
					}
				</ul>
				<p class="note">{talksNote}</p>
			</section>

			<section id="praise" aria-labelledby="praise-heading">
				<h2 id="praise-heading">What people say</h2>
				{
					featured && (
						<figure class="feature">
							<blockquote cite={links.recommendations}>
								<p>
									<span class="feature-mark">“</span>{featured.quote}”
								</p>
							</blockquote>
							<figcaption>
								<span class="feature-name">{featured.name}</span> · {featured.relationship}
							</figcaption>
						</figure>
					)
				}
				<div class="carousel-head">
					<div class="carousel-controls" data-carousel-controls hidden>
						<button type="button" class="carousel-button" data-carousel-step="-1" aria-controls="quotes" aria-label="Previous recommendations">
							<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" /></svg>
						</button>
						<button type="button" class="carousel-button" data-carousel-step="1" aria-controls="quotes" aria-label="Next recommendations">
							<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" /></svg>
						</button>
					</div>
				</div>
				<div class="quotes-viewport" id="quotes" role="region" aria-label="Recommendations (scrolls sideways)" tabindex="0" data-carousel>
					<ul class="quotes">
						{
							carouselTestimonials.map((testimonial) => (
								<li class="quote-item">
									<figure class="quote">
										<blockquote cite={links.recommendations}>
											<p>“{testimonial.quote}”</p>
										</blockquote>
										<figcaption>
											<span class="quote-name">{testimonial.name}</span>
											<span class="quote-relationship">{testimonial.relationship}</span>
										</figcaption>
									</figure>
								</li>
							))
						}
					</ul>
				</div>
				<p class="more">
					<a href={links.recommendations}>Read all {testimonials.length} recommendations on LinkedIn</a>
				</p>
			</section>

			<section id="writing" aria-labelledby="writing-heading">
				<h2 id="writing-heading">Writing</h2>
				<p>{writing.summary}</p>
				<ul class="posts">
					{
						writing.posts.map((post) => (
							<li>
								<a href={post.href}>{post.title}</a> <span class="meta">thoughtbot · {post.year}</span>
							</li>
						))
					}
				</ul>
				<p class="more">
					<a href={links.thoughtbot}>All my posts on thoughtbot’s blog</a>
					<span aria-hidden="true"> · </span>
					<a href={links.blog}>My old blog, 2013–2019</a>
				</p>
			</section>

			<section id="outside-work" aria-labelledby="outside-work-heading">
				<h2 id="outside-work-heading">Outside work</h2>
				<p>{person.personal}</p>
			</section>

			<section id="contact" aria-labelledby="contact-heading">
				<h2 id="contact-heading">Let’s talk</h2>
				<p class="contact-lead">
					If you’re building an engineering org that people want to be part of, I’d love to hear about it.
				</p>
				<p class="where">
					<span>{person.location}</span>
					<span>{person.workPreferences}</span>
				</p>
				<ContactLinks label="Get in touch again" />
			</section>
		</main>

		<footer class="site-footer">
			<p>
				© 2026 {person.name} · <a href={links.email}>{links.emailAddress}</a> ·
				<a href={links.github}>GitHub</a>
			</p>
		</footer>

		<div class="contact-bar" data-contact-bar>
			<div class="contact-bar-inner">
				<p class="contact-bar-name">{person.name}</p>
				<ContactLinks label="Quick contact" compact />
			</div>
		</div>

		<script>
			const viewport = document.querySelector<HTMLElement>('[data-carousel]');
			const controls = document.querySelector<HTMLElement>('[data-carousel-controls]');

			if (viewport && controls) {
				const buttons = controls.querySelectorAll<HTMLButtonElement>('[data-carousel-step]');
				const step = () => {
					const item = viewport.querySelector<HTMLElement>('.quote-item');
					const gap = parseFloat(getComputedStyle(viewport.firstElementChild as Element).columnGap) || 0;
					return item ? item.offsetWidth + gap : viewport.clientWidth;
				};
				const update = () => {
					const max = viewport.scrollWidth - viewport.clientWidth;
					buttons.forEach((button) => {
						const direction = Number(button.dataset.carouselStep);
						button.disabled = direction < 0 ? viewport.scrollLeft <= 1 : viewport.scrollLeft >= max - 1;
					});
				};

				buttons.forEach((button) =>
					button.addEventListener('click', () => {
						viewport.scrollBy({ left: Number(button.dataset.carouselStep) * step() });
					}),
				);
				viewport.addEventListener('scroll', update, { passive: true });
				window.addEventListener('resize', update);
				controls.hidden = false;
				update();
			}

			// Show the contact bar once the hero buttons have scrolled away, and hide it
			// again while the closing contact buttons are on screen.
			const bar = document.querySelector<HTMLElement>('[data-contact-bar]');
			const [heroCta, contactCta] = document.querySelectorAll<HTMLElement>('.cta');

			if (bar && heroCta && contactCta) {
				const update = () => {
					const heroPassed = heroCta.getBoundingClientRect().bottom < 0;
					const contact = contactCta.getBoundingClientRect();
					const contactVisible = contact.top < window.innerHeight && contact.bottom > 0;
					bar.toggleAttribute('data-visible', heroPassed && !contactVisible);
				};

				window.addEventListener('scroll', update, { passive: true });
				window.addEventListener('resize', update);
				update();
			}
		</script>
	</body>
</html>
